<Page x:Class="UP01_Korzh_Polls.Pages.PollTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="950"
      Title="Управление таблицей опросов и голосований">

        <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0" x:Name="DataGridPoll" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  SelectionMode="Extended">
            <DataGrid.Resources>
                <Style x:Key="WrapTextColumnStyle" TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="4,2"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"/>
                <DataGridTextColumn Header="Дата создания" Binding="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm'}" Width="125"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding User.FullName}" Width="1.3*" ElementStyle="{StaticResource WrapTextColumnStyle}"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category.Name}" Width="1.3*" ElementStyle="{StaticResource WrapTextColumnStyle}"/>
                <DataGridTextColumn Header="Название опроса" Binding="{Binding Title}" Width="2*" ElementStyle="{StaticResource WrapTextColumnStyle}"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="90"/>
                <DataGridTextColumn Header="Анонимный" Binding="{Binding IsAnonymous}" Width="85"/>

                <DataGridTemplateColumn Header="Действия" Width="155">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="ButtonEdit" 
                                    Content="Редактировать" 
                                    ToolTip="Редактировать параметры опроса" 
                                    Height="28" MinWidth="120" Padding="6,2" FontSize="12" Margin="2"
                                    HorizontalAlignment="Center"
                                    Click="ButtonEdit_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

                <Grid Grid.Row="1" Margin="0,12,0,0">
            <Button x:Name="ButtonAdd" 
                    Content="Добавить опрос" 
                    ToolTip="Создать новый опрос или голосование" 
                    HorizontalAlignment="Left" 
                    Height="36"
                    Click="ButtonAdd_Click"/>

            <Button x:Name="ButtonDel" 
                    Content="Удалить выбранные" 
                    ToolTip="Удалить выбранные опросы (включая вопросы и ответы каскадно)" 
                    Style="{DynamicResource DangerButtonStyle}"
                    HorizontalAlignment="Right" 
                    Height="36"
                    Click="ButtonDel_Click"/>
        </Grid>
    </Grid>
</Page>
