<Page x:Class="UP01_Korzh_Polls.Pages.CategoryTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="850"
      Title="Управление категориями опросов">

    <!-- Шаг 10. Пункт 8: DataGrid категорий и кнопки управления -->
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0" x:Name="DataGridCategory" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  SelectionMode="Extended">
            <DataGrid.Resources>
                <Style x:Key="WrapTextColumnStyle" TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="4,2"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="Название категории" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource WrapTextColumnStyle}"/>

                <DataGridTemplateColumn Header="Действия" Width="155">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="ButtonEdit" 
                                    Content="Редактировать" 
                                    ToolTip="Изменить название категории" 
                                    Height="28" MinWidth="120" Padding="6,2" FontSize="12" Margin="2"
                                    HorizontalAlignment="Center"
                                    Click="ButtonEdit_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Нижняя панель с кнопками добавления и удаления -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Button x:Name="ButtonAdd" 
                    Content="Добавить категорию" 
                    ToolTip="Создать новую категорию опросов" 
                    HorizontalAlignment="Left" 
                    Height="36"
                    Click="ButtonAdd_Click"/>

            <Button x:Name="ButtonDel" 
                    Content="Удалить выбранные" 
                    ToolTip="Удалить выбранные категории (включая связанные опросы)" 
                    Style="{DynamicResource DangerButtonStyle}"
                    HorizontalAlignment="Right" 
                    Height="36"
                    Click="ButtonDel_Click"/>
        </Grid>
    </Grid>
</Page>
