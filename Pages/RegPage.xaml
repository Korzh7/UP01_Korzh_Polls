<Page x:Class="UP01_Korzh_Polls.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="850"
      Title="Регистрация пользователя">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="{DynamicResource SurfaceColor}" 
                BorderBrush="{DynamicResource BorderBrushColor}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="35,25" 
                Width="500">
            <StackPanel>
                <TextBlock Text="РЕГИСТРАЦИЯ" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,5"
                           Foreground="{DynamicResource PrimaryDarkColor}"/>

                <TextBlock Text="Создание новой учётной записи в системе опросов" 
                           FontSize="12" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,20"
                           Foreground="{DynamicResource MutedTextColor}"/>

                                <Label Content="Логин:" Margin="0,0,0,2"/>
                <Grid Margin="0,0,0,10">
                    <TextBox x:Name="txtbxLog"
                             ToolTip="Введите уникальный логин пользователя"
                             TextChanged="txtbxLog_TextChanged"/>
                    <TextBlock x:Name="lblLogHitn" 
                               Text="Введите логин..." 
                               Foreground="{DynamicResource MutedTextColor}"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </Grid>

                                <Label Content="ФИО:" Margin="0,0,0,2"/>
                <Grid Margin="0,0,0,10">
                    <TextBox x:Name="txtbxFIO"
                             ToolTip="Введите Фамилию, Имя и Отчество полностью"
                             TextChanged="txtbxFIO_TextChanged"/>
                    <TextBlock x:Name="lblFioHitn" 
                               Text="Например: Иванов Иван Иванович" 
                               Foreground="{DynamicResource MutedTextColor}"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </Grid>

                                <Label Content="Email (электронная почта):" Margin="0,0,0,2"/>
                <TextBox x:Name="txtbxEmail"
                         ToolTip="Введите адрес электронной почты"
                         Margin="0,0,0,10"/>

                                <Label Content="Телефон:" Margin="0,0,0,2"/>
                <TextBox x:Name="txtbxPhone"
                         ToolTip="Введите контактный телефон (например, +7 (999) 000-00-00)"
                         Margin="0,0,0,10"/>

                                <Label Content="Пароль:" Margin="0,0,0,2"/>
                <Grid Margin="0,0,0,10">
                    <PasswordBox x:Name="passBxFrst"
                                 ToolTip="Пароль: мин. 6 символов, только латиница, хотя бы одна цифра"
                                 PasswordChanged="passBxFrst_PasswordChanged"/>
                    <TextBlock x:Name="lblPassHitn" 
                               Text="Введите пароль..." 
                               Foreground="{DynamicResource MutedTextColor}"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </Grid>

                                <Label Content="Подтвердите пароль:" Margin="0,0,0,2"/>
                <Grid Margin="0,0,0,10">
                    <PasswordBox x:Name="passBxScnd"
                                 ToolTip="Повторите введенный выше пароль"
                                 PasswordChanged="passBxScnd_PasswordChanged"/>
                    <TextBlock x:Name="lblPassSecHitn" 
                               Text="Повторите пароль..." 
                               Foreground="{DynamicResource MutedTextColor}"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </Grid>

                                <Label Content="Выберите роль:" Margin="0,0,0,2"/>
                <ComboBox x:Name="comboBxRole" 
                          ToolTip="Выберите роль пользователя в системе"
                          Margin="0,0,0,20">
                    <ComboBoxItem Content="User"/>
                    <ComboBoxItem Content="Admin"/>
                </ComboBox>

                                <Button x:Name="regButton"
                        Content="Зарегистрироваться"
                        ToolTip="Нажмите для создания учетной записи"
                        HorizontalAlignment="Stretch"
                        Height="38"
                        Click="regButton_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>
