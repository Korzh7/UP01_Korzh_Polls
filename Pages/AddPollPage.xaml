<Page x:Class="UP01_Korzh_Polls.Pages.AddPollPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_Korzh_Polls.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Данные опроса">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="{DynamicResource SurfaceColor}" 
                BorderBrush="{DynamicResource BorderBrushColor}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="35,25" 
                Width="560">
            <StackPanel>
                <TextBlock x:Name="HeaderTextBlock"
                           Text="ДОБАВЛЕНИЕ ОПРОСА" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,20"
                           Foreground="{DynamicResource PrimaryDarkColor}"/>

                <Label Content="Название опроса:*" Margin="0,0,0,2"/>
                <TextBox x:Name="TBPollTitle" 
                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                         ToolTip="Введите заголовок опроса или голосования" 
                         Margin="0,0,0,10"/>

                <Label Content="Описание (необязательно):" Margin="0,0,0,2"/>
                <TextBox x:Name="TBPollDesc" 
                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                         ToolTip="Введите пояснение или контекст опроса" 
                         Height="60" 
                         TextWrapping="Wrap" 
                         AcceptsReturn="True"
                         Margin="0,0,0,10"/>

                <Label Content="Создатель (Пользователь):*" Margin="0,0,0,2"/>
                <ComboBox x:Name="CBUser" 
                          SelectedValuePath="Id" 
                          SelectedValue="{Binding Path=UserId, Mode=TwoWay}" 
                          DisplayMemberPath="FullName" 
                          ToolTip="Выберите создателя опроса"
                          Margin="0,0,0,10"/>

                <Label Content="Тематическая категория:*" Margin="0,0,0,2"/>
                <ComboBox x:Name="CBCategory" 
                          SelectedValuePath="Id" 
                          SelectedValue="{Binding Path=CategoryId, Mode=TwoWay}" 
                          DisplayMemberPath="Name" 
                          ToolTip="Выберите тематическую категорию"
                          Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <Label Content="Статус:" Margin="0,0,0,2"/>
                        <ComboBox x:Name="CBStatus" ToolTip="Выберите статус активности">
                            <ComboBoxItem Content="Активен" IsSelected="True"/>
                            <ComboBoxItem Content="Приостановлен"/>
                            <ComboBoxItem Content="Завершен"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,18,0,0">
                        <CheckBox x:Name="ChbAnonymous" 
                                  Content="Анонимное голосование" 
                                  IsChecked="{Binding IsAnonymous}" 
                                  ToolTip="Скрывать автора ответа при голосовании"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Button x:Name="ButtonClean" 
                            Content="Очистить" 
                            ToolTip="Очистить поля формы" 
                            Style="{DynamicResource DangerButtonStyle}"
                            HorizontalAlignment="Left" 
                            Height="36" MinWidth="130"
                            Click="ButtonClean_Click"/>

                    <Button x:Name="ButtonSave" 
                            Content="Сохранить" 
                            ToolTip="Сохранить опрос в базе данных" 
                            HorizontalAlignment="Right" 
                            Height="36" MinWidth="130"
                            Click="ButtonSave_Click"/>
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</Page>
