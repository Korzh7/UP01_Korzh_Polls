<Page x:Class="UP01_Korzh_Polls.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="950"
      Title="Личный кабинет пользователя — Список пользователей">

        <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource SurfaceColor}" 
                BorderBrush="{DynamicResource BorderBrushColor}" 
                BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                
                                <TextBlock Text="Введите ФИО для поиска:" VerticalAlignment="Center" Margin="5,0"/>
                <TextBox x:Name="fioFilterTextBox" MinWidth="160" Height="32" Margin="5,0,15,0"
                         ToolTip="Введите часть ФИО для фильтрации списка"
                         TextChanged="fioFilterTextBox_TextChanged"/>

                                <TextBlock Text="Сортировка по ФИО:" VerticalAlignment="Center" Margin="5,0"/>
                <ComboBox x:Name="sortComboBox" SelectedIndex="0" Width="150" Height="32" Margin="5,0,15,0"
                          ToolTip="Выберите направление сортировки"
                          SelectionChanged="sortComboBox_SelectionChanged">
                    <ComboBoxItem Content="По возрастанию (А-Я)"/>
                    <ComboBoxItem Content="По убыванию (Я-А)"/>
                </ComboBox>

                                <CheckBox x:Name="onlyAdminCheckBox" Content="Только администраторы" 
                          VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="5,0,15,0"
                          ToolTip="Отобразить только пользователей с ролью Admin"
                          Checked="onlyAdminCheckBox_Checked" 
                          Unchecked="onlyAdminCheckBox_Unchecked"/>

                                <Button x:Name="clearFiltersButton" Content="Очистить фильтр" 
                        ToolTip="Сбросить параметры поиска и фильтрации"
                        Height="32" MinWidth="130"
                        Click="clearFiltersButton_Click_1"/>
            </WrapPanel>
        </Border>

                <ListView x:Name="ListUser" Grid.Row="1" 
                  BorderThickness="0"
                  Background="Transparent"
                  HorizontalContentAlignment="Center" 
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource SurfaceColor}" 
                            BorderBrush="{DynamicResource BorderBrushColor}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Margin="8" 
                            Padding="12" 
                            Width="220" 
                            Height="310">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="180"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0" 
                                       Text="{Binding FullName}" 
                                       FontWeight="Bold" 
                                       FontSize="14" 
                                       TextWrapping="Wrap" 
                                       TextAlignment="Center" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,6"
                                       Foreground="{DynamicResource PrimaryDarkColor}"/>

                                                        <Border Grid.Row="1" CornerRadius="6" ClipToBounds="True" Background="#EEEEEE" Margin="0,0,0,8">
                                <Image Stretch="UniformToFill" HorizontalAlignment="Center" Source="{Binding Photo}"/>
                            </Border>

                                                        <TextBlock Grid.Row="2" 
                                       Text="{Binding Role, StringFormat='Роль: {0}'}" 
                                       FontSize="12" 
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryColor}"/>

                                                        <TextBlock Grid.Row="3" 
                                       Text="{Binding Login, StringFormat='Логин: @{0}'}" 
                                       FontSize="11" 
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextColor}"
                                       Margin="0,2,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
