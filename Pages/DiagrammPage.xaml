<Page x:Class="UP01_Korzh_Polls.Pages.DiagrammPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_Korzh_Polls.Pages"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Аналитика и экспорт отчетов (Word / Excel)">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceColor}" 
                BorderBrush="{DynamicResource BorderBrushColor}" 
                BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <TextBlock Text="Пользователь:" VerticalAlignment="Center" Margin="5,0"/>
                <ComboBox x:Name="CmbUser" DisplayMemberPath="FullName" 
                          Width="230" Height="32" Margin="5,0,15,0"
                          ToolTip="Выберите пользователя для построения отчета и графика"
                          SelectionChanged="UpdateChart"/>

                <TextBlock Text="Активность:" VerticalAlignment="Center" Margin="5,0"/>
                <ComboBox x:Name="CmbActivity" 
                          Width="220" Height="32" Margin="5,0,15,0"
                          ToolTip="Выберите срез активности: создание опросов, участие в опросах или всё вместе"
                          SelectionChanged="UpdateChart">
                    <ComboBoxItem Content="Сводка (Создано и Участие)" IsSelected="True"/>
                    <ComboBoxItem Content="Только созданные опросы (автор)"/>
                    <ComboBoxItem Content="Только участие в опросах"/>
                </ComboBox>

                <TextBlock Text="Тип диаграммы:" VerticalAlignment="Center" Margin="5,0"/>
                <ComboBox x:Name="CmbDiagram" 
                          Width="210" Height="32" Margin="5,0,15,0"
                          ToolTip="Выберите вид графического отображения"
                          SelectionChanged="UpdateChart">
                    <ComboBoxItem Content="Столбчатая (Column)" IsSelected="True"/>
                    <ComboBoxItem Content="Круговая (Pie)"/>
                    <ComboBoxItem Content="Линейная (Line)"/>
                </ComboBox>

                <Button x:Name="BtnExportExcel" 
                        Content="Экспорт в Excel (.xlsx)" 
                        ToolTip="Выгрузить структурированный отчет в Microsoft Excel" 
                        Height="32" MinWidth="140" Margin="5,4"
                        Click="BtnExportExcel_Click"/>

                <Button x:Name="BtnExportWord" 
                        Content="Экспорт в Word (.docx)" 
                        ToolTip="Сформировать аналитическую записку в Microsoft Word" 
                        Height="32" MinWidth="140" Margin="5,4"
                        Click="BtnExportWord_Click"/>

                <Button x:Name="BtnExportPdf" 
                        Content="Экспорт в PDF (.pdf)" 
                        ToolTip="Сформировать аналитический отчет в формате PDF" 
                        Height="32" MinWidth="140" Margin="5,4"
                        Click="BtnExportPdf_Click"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceColor}" 
                BorderBrush="{DynamicResource BorderBrushColor}" 
                BorderThickness="1" CornerRadius="6" Padding="15">
            <Grid>

                <lvc:CartesianChart x:Name="CartesianChartControl" Visibility="Visible" LegendLocation="Top">
                    <lvc:CartesianChart.ChartLegend>
                        <lvc:DefaultLegend Foreground="{DynamicResource TextColor}"/>
                    </lvc:CartesianChart.ChartLegend>
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis x:Name="AxisX" Title="Тематические категории опросов" Foreground="{DynamicResource TextColor}"/>
                    </lvc:CartesianChart.AxisX>
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis x:Name="AxisY" Title="Количество опросов" Foreground="{DynamicResource TextColor}"/>
                    </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>

                <lvc:PieChart x:Name="PieChartControl" Visibility="Collapsed" LegendLocation="Right">
                    <lvc:PieChart.ChartLegend>
                        <lvc:DefaultLegend Foreground="{DynamicResource TextColor}"/>
                    </lvc:PieChart.ChartLegend>
                </lvc:PieChart>
            </Grid>
        </Border>
    </Grid>
</Page>
