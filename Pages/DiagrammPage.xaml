<Page x:Class="UP01_Korzh_Polls.Pages.DiagrammPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="950"
      Title="Аналитика и экспорт отчетов (Word / Excel)">

    <!-- Шаг 12. Пункт 5: Разметка на 2 строки (верх: фильтры и кнопки, низ: диаграмма) -->
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель: выбор пользователя, выбор типа диаграммы, кнопки экспорта в Excel и Word -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceColor}" 
                BorderBrush="{DynamicResource BorderBrushColor}" 
                BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                
                <!-- Шаг 12. Пункт 6: Выбор пользователя с DisplayMemberPath="FullName" -->
                <TextBlock Text="Пользователь (автор):" VerticalAlignment="Center" Margin="5,0"/>
                <ComboBox x:Name="CmbUser" DisplayMemberPath="FullName" 
                          Width="260" Height="32" Margin="5,0,15,0"
                          ToolTip="Выберите пользователя для построения отчета и графика"
                          SelectionChanged="UpdateChart"/>

                <!-- Шаг 12. Пункт 5: Выбор типа диаграммы -->
                <TextBlock Text="Тип диаграммы:" VerticalAlignment="Center" Margin="5,0"/>
                <ComboBox x:Name="CmbDiagram" 
                          Width="160" Height="32" Margin="5,0,15,0"
                          ToolTip="Выберите вид графического отображения"
                          SelectionChanged="UpdateChart">
                    <ComboBoxItem Content="Столбчатая (Column)" IsSelected="True"/>
                    <ComboBoxItem Content="Круговая (Pie)"/>
                    <ComboBoxItem Content="Линейная (Line)"/>
                </ComboBox>

                <!-- Шаг 14: Экспорт в Excel -->
                <Button x:Name="BtnExportExcel" 
                        Content="Экспорт в Excel (.xlsx)" 
                        ToolTip="Выгрузить структурированный отчет в Microsoft Excel" 
                        Height="32" MinWidth="150" Margin="5,0"
                        Click="BtnExportExcel_Click"/>

                <!-- Шаг 13: Экспорт в Word -->
                <Button x:Name="BtnExportWord" 
                        Content="Экспорт в Word (.docx)" 
                        ToolTip="Сформировать аналитическую записку в Microsoft Word" 
                        Height="32" MinWidth="150" Margin="5,0"
                        Click="BtnExportWord_Click"/>
            </WrapPanel>
        </Border>

        <!-- Шаг 12. Пункт 8: Область отображения графика / диаграммы -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceColor}" 
                BorderBrush="{DynamicResource BorderBrushColor}" 
                BorderThickness="1" CornerRadius="6" Padding="15">
            <Grid>
                <!-- Столбчатая / линейная диаграмма -->
                <lvc:CartesianChart x:Name="CartesianChartControl" Visibility="Visible" LegendLocation="Top">
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis x:Name="AxisX" Title="Тематические категории опросов"/>
                    </lvc:CartesianChart.AxisX>
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis Title="Количество созданных опросов"/>
                    </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>

                <!-- Круговая диаграмма -->
                <lvc:PieChart x:Name="PieChartControl" Visibility="Collapsed" LegendLocation="Right"/>
            </Grid>
        </Border>
    </Grid>
</Page>
