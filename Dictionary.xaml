<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Цветовая гамма по методичке (Основная корпоративная тема) -->
    <!-- Основные цвета: #FFFFFF, #F3F3F3, #0198AF, #233E76 -->
    <!-- Дополнительные: #EAEBED, #4DC6C5, #275E9F, #9197A3, #DD4B42 -->
    <SolidColorBrush x:Key="PrimaryColor" Color="#0198AF" />
    <SolidColorBrush x:Key="PrimaryDarkColor" Color="#233E76" />
    <SolidColorBrush x:Key="BackgroundColor" Color="#F3F3F3" />
    <SolidColorBrush x:Key="SurfaceColor" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextColor" Color="#233E76" />
    <SolidColorBrush x:Key="MutedTextColor" Color="#9197A3" />
    <SolidColorBrush x:Key="AccentColor" Color="#4DC6C5" />
    <SolidColorBrush x:Key="DangerColor" Color="#DD4B42" />
    <SolidColorBrush x:Key="BorderBrushColor" Color="#CBD3DC" />

    <!-- Единый шрифт приложения с кириллической поддержкой -->
    <FontFamily x:Key="AppFontFamily">Segoe UI, Open Sans, Arial, sans-serif</FontFamily>

    <!-- Стиль кнопки -->
    <Style TargetType="Button">
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="130" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="6" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{StaticResource PrimaryColor}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentColor}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#CCCCCC" />
                <Setter Property="Foreground" Value="#777777" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Стиль вторичной кнопки (Danger / Очистить / Удалить) -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource DangerColor}" />
    </Style>

    <!-- Стиль меток (Label) -->
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextColor}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Стиль текстовых блоков (TextBlock) -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextColor}" />
    </Style>

    <!-- Стиль полей ввода (TextBox) -->
    <Style TargetType="TextBox">
        <Setter Property="Height" Value="34" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{StaticResource SurfaceColor}" />
        <Setter Property="Foreground" Value="{StaticResource TextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Стиль полей ввода пароля (PasswordBox) -->
    <Style TargetType="PasswordBox">
        <Setter Property="Height" Value="34" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{StaticResource SurfaceColor}" />
        <Setter Property="Foreground" Value="{StaticResource TextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Стиль выпадающего списка (ComboBox) -->
    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="34" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{StaticResource SurfaceColor}" />
        <Setter Property="Foreground" Value="{StaticResource TextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <!-- Стиль элементов выпадающего списка (ComboBoxItem) -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextColor}" />
        <Setter Property="Background" Value="{StaticResource SurfaceColor}" />
        <Setter Property="Padding" Value="8,6" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{StaticResource BackgroundColor}" />
                <Setter Property="Foreground" Value="{StaticResource TextColor}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentColor}" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
