<Window x:Class="UP01_Korzh_Polls.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP01_Korzh_Polls"
        mc:Ignorable="d"
        Title="Платформа опросов и голосований — DB_Korzh_Polls" 
        Height="650" Width="1000"
        MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundColor}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    
    <Grid>
                <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource PrimaryDarkColor}" Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                                <Button x:Name="ButtonBack" 
                        Grid.Column="0"
                        Content="Назад" 
                        ToolTip="Вернуться на предыдущую страницу" 
                        Click="ButtonBack_Click" 
                        Visibility="Hidden"
                        MinWidth="90" Height="32" Margin="0,0,10,0"/>

                                <TextBlock x:Name="PageTitle" 
                           Grid.Column="1"
                           Text="Авторизация" 
                           Foreground="White" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center" 
                           Margin="10,0"/>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Тема:" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="13" FontWeight="SemiBold"/>
                    <ComboBox x:Name="ThemeComboBox" 
                              Width="195" Height="32" 
                              ToolTip="Выбор цветовой темы оформления"
                              SelectionChanged="ThemeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Светлая (Фирменная)" IsSelected="True"/>
                        <ComboBoxItem Content="Тёмная тема"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

                <Frame x:Name="MainFrame" 
               Grid.Row="1" 
               NavigationUIVisibility="Hidden" 
               Navigated="MainFrame_Navigated"/>

                <Border Grid.Row="2" Background="{DynamicResource PrimaryDarkColor}" Padding="15,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="УП.01.01 — Корж С.В. | Платформа опросов и голосований" 
                           Foreground="White" 
                           VerticalAlignment="Center" 
                           FontSize="12"/>

                                <TextBlock x:Name="DateTimeNow" 
                           Grid.Column="1"
                           Foreground="White" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Right"
                           FontSize="12" 
                           FontWeight="SemiBold"/>
            </Grid>
        </Border>
    </Grid>
</Window>
